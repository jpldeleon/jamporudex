# ----------------------------------------------------
# JamporuDex Environment Variables
# Copy this file to ".env" and fill in your own values.
# ----------------------------------------------------

# Server
PORT=3000

# PostgreSQL connection
PGUSER=postgres
PGPASSWORD=your_password_here
PGHOST=localhost
PGPORT=5432
PGDATABASE=jamporudex

# Jikan API (MyAnimeList v4) — no key required, public API
JIKAN_BASE_URL=https://api.jikan.moe/v4
