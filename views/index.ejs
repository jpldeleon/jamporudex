<!DOCTYPE html>
<html lang="en" data-theme="tokyo-night-storm">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>JamporuDEX</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Zen+Kaku+Gothic+New:wght@500;700&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A=="
    crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="icon" type="image/png" href="/public/css/icons/dex_favicon.png">
</head>

<body>

  <!-- ============================================================
       HEADER
  ============================================================ -->
  <header class="site-header">
    <a href="/" class="logo-link">
      <h1 class="logo">
        <span class="logo-en">JamporuDEX</span>
      </h1>
    </a>
    <p class="tagline">A curated index of the anime and manga that have left a lasting impression on me, from nostalgic
      childhood favorites to unforgettable modern titles.</p>

    <!-- Sort / Filter controls -->
    <form class="controls-bar" method="GET" action="/">
      <div class="control-group">
        <label for="sort">Sort</label>
        <select id="sort" name="sort" onchange="this.form.submit()">
          <option value="recency" <%=currentSort==='recency' ? 'selected' : '' %>>Recently Added</option>
          <option value="rating" <%=currentSort==='rating' ? 'selected' : '' %>>Rating</option>
          <option value="title" <%=currentSort==='title' ? 'selected' : '' %>>Title</option>
        </select>
      </div>
      <div class="control-group">
        <label for="filter">Status</label>
        <select id="filter" name="filter" onchange="this.form.submit()">
          <% ['All','Reading','Watching','Completed','On-Hold','Dropped','Plan to Read'].forEach(function(s){ %>
            <option value="<%= s %>" <%=currentFilter===s ? 'selected' : '' %>><%= s %>
            </option>
            <% }); %>
        </select>
      </div>
    </form>
  </header>

  <!-- ============================================================
       MAIN GRID
  ============================================================ -->
  <main class="container">
    <% if (entries.length===0) { %>
      <div class="empty-state">
        <p>Your index is empty. Hit <strong>+ Add Entry</strong> below to start tracking.</p>
      </div>
      <% } else { %>
        <section class="entry-grid">
          <% entries.forEach(function(entry) { %>
            <article class="entry-card" data-id="<%= entry.id %>" data-title="<%= entry.title %>"
              data-cover="<%= entry.cover_url %>" data-synopsis="<%= (entry.synopsis || '').replace(/" /g, '&quot;' ) %>
              "
              data-review="<%= (entry.review || '' ).replace(/"/g, '&quot;' ) %>"
                data-status="<%= entry.status %>"
                  data-progress="<%= entry.progress || '' %>"
                    data-rating="<%= entry.rating || '' %>"
                      data-type="<%= entry.media_type %>"
                        >
                        <button class="card-cover-btn" aria-label="Open <%= entry.title %>">
                          <img class="card-cover" src="<%= entry.cover_url %>" alt="<%= entry.title %> cover"
                            loading="lazy" />
                          <span class="badge badge-status status-<%= entry.status.replace(/\s+/g,'-').toLowerCase() %>">
                            <%= entry.status %>
                          </span>
                        </button>
                        <div class="card-body">
                          <h3 class="card-title">
                            <%= entry.title %>
                          </h3>
                          <p class="card-progress">
                            <%= entry.progress || '—' %>
                          </p>
                          <div class="card-rating" aria-label="Rating <%= entry.rating || 0 %> of 10">
                            <% for (let i=1; i <=10; i++) { %>
                              <span class="star <%= i <= (entry.rating || 0) ? 'star-filled' : '' %>">★</span>
                              <% } %>
                          </div>
                          <% if (entry.review) { %>
                            <p class="card-review">"<%= entry.review.length> 90 ? entry.review.slice(0,90)+'…' :
                                entry.review %>"</p>
                            <% } %>
                        </div>
            </article>
            <% }); %>
        </section>
        <% } %>
  </main>

  <!-- ============================================================
       DEX FLOATING NAV PILL
       Always fully expanded — DEX / Add / Theme / Scroll-up are all
       permanently visible and interactive, even while the DEX popup
       below is open. The popup opens ONLY from the DEX button itself
       (hover on desktop, tap on touch via main.js) — never from
       hovering Add, Theme, or Scroll-up.
  ============================================================ -->
  <div class="dex-pill-anchor" id="dexPillAnchor">
    <div class="dex-pill">
      <div class="dex-pill__dex-wrap">
        <button type="button" class="dex-pill__btn dex-pill__dex" id="dexTrigger" aria-haspopup="true"
          aria-expanded="false" aria-label="DEX menu">
          <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" class="dex-icon">
            <path
              d="M0 0 C0 0.99 0 1.98 0 3 C-0.61488281 3.14695313 -1.22976563 3.29390625 -1.86328125 3.4453125 C-7.21808396 4.90668748 -7.21808396 4.90668748 -11.0625 8.75 C-12.58007494 14.01092644 -12.84847898 17.39395049 -10.25 22.3125 C-7.06550196 26.11620599 -5.52860114 26.83015543 -0.625 27.375 C3.84403427 26.91268611 5.74190349 26.10655714 9 23 C10.70509109 18.97388183 11.46293975 15.45495351 10.125 11.25 C9.75375 10.5075 9.3825 9.765 9 9 C8.875 6.1875 8.875 6.1875 9 4 C12.3954448 5.40501164 14.05853217 6.88271362 16 10 C16.9781355 15.81127563 16.38672757 21.09508421 13 26 C10.5625 28.25 10.5625 28.25 8 30 C7.401875 30.4125 6.80375 30.825 6.1875 31.25 C2.77390637 32.42037496 -0.4700267 32.54622411 -4 32 C-9.0883656 29.40593127 -13.56091937 25.43165382 -15.8125 20.0625 C-15.874375 19.381875 -15.93625 18.70125 -16 18 C-16.144375 16.9275 -16.28875 15.855 -16.4375 14.75 C-15.83522523 9.58764482 -13.69657769 6.58358186 -10 3 C-6.7642814 0.95207683 -3.87318958 0 0 0 Z "
              fill="currentColor" transform="translate(16,0)" />
            <path d="M0 0 C0.66 0 1.32 0 2 0 C2 0.66 2 1.32 2 2 C1.34 2 0.68 2 0 2 C0 1.34 0 0.68 0 0 Z "
              fill="currentColor" transform="translate(17,1)" />
            <path d="M0 0 C0.99 0.495 0.99 0.495 2 1 C1.01 1.495 1.01 1.495 0 2 C0 1.34 0 0.68 0 0 Z "
              fill="currentColor" transform="translate(20,2)" />
          </svg>
        </button>

        <div class="dex-popup" id="dexPopup">
          <a class="dex-popup__link dex-popup__link--a" href="https://jpldeleon.github.io/" target="_blank"
            rel="noopener">
            <i class="fa-solid fa-file-lines"></i> CV &amp; Portfolio
          </a>
          <a class="dex-popup__link dex-popup__link--b" href="https://github.com/jpldeleon/JamporuDEX" target="_blank"
            rel="noopener">
            <i class="fa-brands fa-github"></i> JamporuDEX Repo
          </a>
          <button type="button" class="dex-popup__link dex-popup__link--a" id="dexCopyEmailBtn"
            data-user="jpleonard.deleon" data-domain="gmail.com">
            <i class="fa-solid fa-envelope"></i> Copy Email
          </button>

          <div class="dex-popup__hr"></div>
          <button type="button" class="dex-popup__label-btn" id="otherProjectsToggle" aria-expanded="false">Project Directory</button>
          <div class="dex-popup__sublist" id="otherProjectsList">
            <div class="dex-sublist-items">
              <a href="https://johnoffthewall.github.io/" target="_blank" rel="noopener"
                class="dex-sublink dex-sublink--1">John Off the Wall</a>
              <a href="https://johnoffthewall.github.io/" target="_blank" rel="noopener"
                class="dex-sublink dex-sublink--2">AuditKit</a>
              <a href="https://route196.onrender.com/" target="_blank" rel="noopener"
                class="dex-sublink dex-sublink--3">Route 196</a>
              <a href="https://pixellog-dev.onrender.com/" target="_blank" rel="noopener"
                class="dex-sublink dex-sublink--4">PixelLog</a>
            </div>
          </div>
        </div>
      </div>

      <span class="dex-pill__divider"></span>

      <button id="openAddModal" type="button" class="dex-pill__btn dex-pill__add" aria-label="Add entry">
        <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" class="dex-icon">
          <path
            d="M0 0 C0.66 0 1.32 0 2 0 C2.99 2.97 3.98 5.94 5 9 C4.34 9.66 3.68 10.32 3 11 C3.66 11.33 4.32 11.66 5 12 C5 12.66 5 13.32 5 14 C5.99 14 6.98 14 8 14 C8 13.34 8 12.68 8 12 C10.97 12.99 13.94 13.98 17 15 C17 15.66 17 16.32 17 17 C9.78774617 20.25601751 9.78774617 20.25601751 6.5 19.1875 C6.005 18.795625 5.51 18.40375 5 18 C4.34 19.32 3.68 20.64 3 22 C3.66 22.33 4.32 22.66 5 23 C4.01 25.97 3.02 28.94 2 32 C1.34 32 0.68 32 0 32 C-0.99 29.03 -1.98 26.06 -3 23 C-2.34 22.34 -1.68 21.68 -1 21 C-1.66 20.67 -2.32 20.34 -3 20 C-3 19.34 -3 18.68 -3 18 C-3.680625 18.391875 -4.36125 18.78375 -5.0625 19.1875 C-9.29649749 20.35860569 -11.14937286 18.96306482 -15 17 C-15 16.34 -15 15.68 -15 15 C-12.03 14.01 -9.06 13.02 -6 12 C-6 12.66 -6 13.32 -6 14 C-5.01 14 -4.02 14 -3 14 C-3 13.34 -3 12.68 -3 12 C-2.34 11.34 -1.68 10.68 -1 10 C-1.66 9.67 -2.32 9.34 -3 9 C-2.01 6.03 -1.02 3.06 0 0 Z M0 14 C0 15.32 0 16.64 0 18 C0.99 17.67 1.98 17.34 3 17 C2.67 16.01 2.34 15.02 2 14 C1.34 14 0.68 14 0 14 Z "
            fill="currentColor" transform="translate(15,0)" />
        </svg>
      </button>

      <button id="themeToggle" type="button" class="dex-pill__btn dex-pill__theme" aria-label="Toggle theme">
        <div class="theme-icon-wrapper">
          <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" class="dex-icon theme-icon">
            <path
              d="M0 0 C4.90025583 2.08539784 7.63183467 5.27053359 10 10 C10.91469792 15.59490229 11.07496122 21.23570406 7.8125 26.0625 C4.97701587 29.60010401 1.62054595 31.73506061 -2.8671875 32.46875 C-8.76234082 32.52999835 -12.91027142 32.33909543 -17.59765625 28.58203125 C-22.03474417 23.57640282 -22.58635791 19.46828479 -22.41796875 12.94921875 C-21.81040874 8.66222989 -20.22620183 5.85976903 -17 3 C-11.57528041 -0.88266732 -6.4705304 -0.91701557 0 0 Z M-18 9 C-19.61386527 13.84159581 -19.83616487 18.20821813 -17.6875 22.8125 C-16.22444433 24.70905365 -14.77442053 26.3945719 -13 28 C-12.34 27.67 -11.68 27.34 -11 27 C-11.33 26.67 -11.66 26.34 -12 26 C-12.375 22.625 -12.375 22.625 -12 19 C-9.38723631 16.77146627 -7.00732415 16.00239443 -3.75 14.9375 C-0.86381294 14.31285945 -0.86381294 14.31285945 0 12 C0.36275952 7.88917391 0.36275952 7.88917391 -1.0625 4.125 C-7.35262466 0.47266955 -13.78768046 3.94521656 -18 9 Z M-7 22 C-7 22.66 -7 23.32 -7 24 C-6.34 24 -5.68 24 -5 24 C-5 23.34 -5 22.68 -5 22 C-5.66 22 -6.32 22 -7 22 Z "
              fill="currentColor" transform="translate(22,0)" />
            <path d="M0 0 C1.32 0 2.64 0 4 0 C4 1.32 4 2.64 4 4 C2.68 4 1.36 4 0 4 C0 2.68 0 1.36 0 0 Z "
              fill="currentColor" transform="translate(14,7)" />
          </svg>
        </div>
      </button>

      <button id="scrollTopBtn" type="button" class="dex-pill__btn dex-pill__up" aria-label="Scroll to top">
        <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" class="dex-icon">
          <path
            d="M0 0 C0.66 0 1.32 0 2 0 C3.49821059 3.37097383 4 5.20442119 4 9 C3.34 9 2.68 9 2 9 C0.02 13.95 -1.96 18.9 -4 24 C-4.66 24 -5.32 24 -6 24 C-6.68041782 18.72676192 -4.24786337 14.60611289 -2 10 C-2.66 10 -3.32 10 -4 10 C-3.43697042 6.05879291 -2.3208055 3.2491277 0 0 Z M-2 8 C-1 10 -1 10 -1 10 Z "
            fill="currentColor" transform="translate(17,4)" />
        </svg>
      </button>
    </div>
  </div>

  <div class="dock-toast" id="dockToast" role="status" aria-live="polite"></div>

  <!-- ============================================================
       ADD ENTRY MODAL
  ============================================================ -->
  <div id="addModalOverlay" class="modal-overlay hidden">
    <div class="modal add-modal" role="dialog" aria-modal="true" aria-labelledby="addModalTitle">
      <button class="modal-close" data-close-modal="addModalOverlay" aria-label="Close">&times;</button>
      <h2 id="addModalTitle">Add to Index</h2>

      <div class="search-row">
        <select id="searchType">
          <option value="manga" selected>Manga</option>
          <option value="anime">Anime</option>
        </select>
        <input type="text" id="searchTitle" placeholder="Search by title…" autocomplete="off" />
        <button id="searchBtn" type="button">Search</button>
      </div>

      <div id="searchResults" class="search-results"></div>

      <form id="addForm" action="/entries" method="POST" class="entry-form hidden">
        <input type="hidden" name="mal_id" id="f_mal_id" />
        <input type="hidden" name="title" id="f_title" />
        <input type="hidden" name="media_type" id="f_media_type" />
        <input type="hidden" name="cover_url" id="f_cover_url" />
        <input type="hidden" name="synopsis" id="f_synopsis" />

        <div class="selected-preview" id="selectedPreview"></div>

        <label>Status
          <select name="status">
            <option>Reading</option>
            <option>Watching</option>
            <option>Completed</option>
            <option>On-Hold</option>
            <option>Dropped</option>
            <option>Plan to Read</option>
          </select>
        </label>

        <label>Progress
          <input type="text" name="progress" placeholder="e.g. Ch. 120 / Ep. 12" />
        </label>

        <label>Rating (1–10)
          <input type="number" name="rating" min="1" max="10" placeholder="8" />
        </label>

        <label>Review
          <textarea name="review" rows="3" placeholder="Your thoughts…"></textarea>
        </label>

        <button type="submit" class="btn-primary">Save to Index</button>
      </form>
    </div>
  </div>

  <!-- ============================================================
       EDIT ENTRY MODAL
  ============================================================ -->
  <div id="editModalOverlay" class="modal-overlay hidden">
    <div class="modal edit-modal" role="dialog" aria-modal="true" aria-labelledby="editModalTitle">
      <button class="modal-close" data-close-modal="editModalOverlay" aria-label="Close">&times;</button>
      <h2 id="editModalTitle">Edit Entry</h2>

      <form id="editForm" class="entry-form" method="POST">
        <label>Status
          <select name="status" id="e_status">
            <option>Reading</option>
            <option>Watching</option>
            <option>Completed</option>
            <option>On-Hold</option>
            <option>Dropped</option>
            <option>Plan to Read</option>
          </select>
        </label>

        <label>Progress
          <input type="text" name="progress" id="e_progress" />
        </label>

        <label>Rating (1–10)
          <input type="number" name="rating" id="e_rating" min="1" max="10" />
        </label>

        <label>Review
          <textarea name="review" id="e_review" rows="3"></textarea>
        </label>

        <button type="submit" class="btn-primary">Save Changes</button>
      </form>
    </div>
  </div>

  <!-- ============================================================
       LIGHTBOX
  ============================================================ -->
  <div id="lightboxOverlay" class="lightbox-overlay hidden">
    <div class="lightbox" role="dialog" aria-modal="true">
      <button class="modal-close" id="lightboxClose" aria-label="Close">&times;</button>
      <div class="lightbox-grid">
        <img id="lb_cover" class="lightbox-cover" src="" alt="" />
        <div class="lightbox-info">
          <span class="badge" id="lb_type"></span>
          <h2 id="lb_title"></h2>
          <div class="lightbox-rating" id="lb_rating"></div>
          <p class="lightbox-progress" id="lb_progress"></p>
          <h4>Synopsis</h4>
          <p class="lightbox-synopsis" id="lb_synopsis"></p>
          <h4>Your Review</h4>
          <p class="lightbox-review" id="lb_review"></p>
          <div class="lightbox-actions">
            <button id="lb_edit" class="btn-secondary">Edit</button>
            <form id="lb_deleteForm" method="POST">
              <button type="submit" class="btn-danger">Delete</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/main.js"></script>
</body>

</html>